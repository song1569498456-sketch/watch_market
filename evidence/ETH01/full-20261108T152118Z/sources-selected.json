          "line": 193,
          "text": "    }"
        },
        {
          "line": 194,
          "text": ""
        },
        {
          "line": 195,
          "text": "    /// @notice Returns all withdrawal requests that belongs to the `_owner` address"
        },
        {
          "line": 196,
          "text": "    ///"
        },
        {
          "line": 197,
          "text": "    /// WARNING: This operation will copy the entire storage to memory, which can be quite expensive. This is designed"
        },
        {
          "line": 198,
          "text": "    /// to mostly be used by view accessors that are queried without any gas fees. Developers should keep in mind that"
        },
        {
          "line": 205,
          "text": "    /// @notice Returns status for requests with provided ids"
        },
        {
          "line": 206,
          "text": "    /// @param _requestIds array of withdrawal request ids"
        },
        {
          "line": 207,
          "text": "    function getWithdrawalStatus(uint256[] calldata _requestIds)"
        },
        {
          "line": 208,
          "text": "        external"
