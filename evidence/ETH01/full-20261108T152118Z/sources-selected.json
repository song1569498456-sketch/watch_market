        {
          "line": 92,
          "text": "    // Mint rETH"
        },
        {
          "line": 94,
          "text": "    function mint(uint256 _ethAmount, address _to) override external onlyLatestContract(\"rocketDepositPool\", msg.sender) {"
        },
        {
          "line": 95,
          "text": "        // Get rETH amount"
        },
        {
          "line": 96,
          "text": "        uint256 rethAmount = getRethValue(_ethAmount);"
        },
        {
          "line": 97,
          "text": "        // Check rETH amount"
        },
        {
          "line": 98,
          "text": "        require(rethAmount > 0, \"Invalid token mint amount\");"
        },
        {
          "line": 99,
          "text": "        // Update balance & supply"
        },
        {
          "line": 100,
          "text": "        _mint(_to, rethAmount);"
        },
        {
          "line": 101,
          "text": "        // Emit tokens minted event"
        },
        {
          "line": 102,
          "text": "        emit TokensMinted(_to, rethAmount, _ethAmount, block.timestamp);"
        },
        {
          "line": 103,
          "text": "    }"
