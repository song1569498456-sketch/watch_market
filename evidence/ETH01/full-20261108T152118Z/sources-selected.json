        {
          "line": 38,
          "text": "    // Calculate the amount of ETH backing an amount of rETH"
        },
        {
          "line": 39,
          "text": "    function getEthValue(uint256 _rethAmount) override public view returns (uint256) {"
        },
        {
          "line": 40,
          "text": "        // Get network balances"
        },
        {
          "line": 41,
          "text": "        RocketNetworkBalancesInterface rocketNetworkBalances = RocketNetworkBalancesInterface(getContractAddress(\"rocketNetworkBalances\"));"
        },
        {
          "line": 42,
          "text": "        uint256 totalEthBalance = rocketNetworkBalances.getTotalETHBalance();"
        },
        {
          "line": 43,
          "text": "        uint256 rethSupply = rocketNetworkBalances.getTotalRETHSupply();"
        },
        {
          "line": 44,
          "text": "        // Use 1:1 ratio if no rETH is minted"
        },
        {
          "line": 45,
          "text": "        if (rethSupply == 0) { return _rethAmount; }"
        },
        {
          "line": 46,
          "text": "        // Calculate and return"
        },
        {
          "line": 47,
          "text": "        return _rethAmount.mul(totalEthBalance).div(rethSupply);"
        },
        {
          "line": 48,
          "text": "    }"
        },
        {
          "line": 49,
          "text": ""
        },
        {
          "line": 50,
          "text": "    // Calculate the amount of rETH backed by an amount of ETH"
        },
        {
          "line": 51,
          "text": "    function getRethValue(uint256 _ethAmount) override public view returns (uint256) {"
        },
        {
          "line": 52,
          "text": "        // Get network balances"
        },
        {
          "line": 53,
          "text": "        RocketNetworkBalancesInterface rocketNetworkBalances = RocketNetworkBalancesInterface(getContractAddress(\"rocketNetworkBalances\"));"
        },
        {
          "line": 54,
          "text": "        uint256 totalEthBalance = rocketNetworkBalances.getTotalETHBalance();"
        },
        {
          "line": 55,
          "text": "        uint256 rethSupply = rocketNetworkBalances.getTotalRETHSupply();"
        },
        {
          "line": 56,
          "text": "        // Use 1:1 ratio if no rETH is minted"
        },
        {
          "line": 57,
          "text": "        if (rethSupply == 0) { return _ethAmount; }"
        },
        {
          "line": 58,
          "text": "        // Check network ETH balance"
        },
        {
          "line": 59,
          "text": "        require(totalEthBalance > 0, \"Cannot calculate rETH token amount while total network balance is zero\");"
        },
        {
          "line": 60,
          "text": "        // Calculate and return"
        },
        {
          "line": 61,
          "text": "        return _ethAmount.mul(rethSupply).div(totalEthBalance);"
        },
        {
          "line": 62,
          "text": "    }"
        },
        {
          "line": 63,
          "text": ""
        },
        {
          "line": 65,
          "text": "    // Returns the amount of ETH backing 1 rETH"
        },
        {
          "line": 66,
          "text": "    function getExchangeRate() override external view returns (uint256) {"
        },
        {
          "line": 67,
          "text": "        return getEthValue(1 ether);"
        },
        {
          "line": 68,
          "text": "    }"
        },
        {
          "line": 69,
          "text": ""
        },
        {
          "line": 70,
          "text": "    // Get the total amount of collateral available"
        },
        {
          "line": 71,
          "text": "    // Includes rETH contract balance & excess deposit pool balance"
        },
        {
          "line": 72,
          "text": "    function getTotalCollateral() override public view returns (uint256) {"
        },
        {
          "line": 73,
          "text": "        RocketDepositPoolInterface rocketDepositPool = RocketDepositPoolInterface(getContractAddress(\"rocketDepositPool\"));"
        },
        {
          "line": 74,
          "text": "        return rocketDepositPool.getExcessBalance().add(address(this).balance);"
        },
        {
          "line": 75,
          "text": "    }"
        },
        {
          "line": 76,
          "text": ""
        },
        {
          "line": 77,
          "text": "    // Get the current ETH collateral rate"
        },
        {
          "line": 78,
          "text": "    // Returns the portion of rETH backed by ETH in the contract as a fraction of 1 ether"
        },
        {
          "line": 79,
          "text": "    function getCollateralRate() override public view returns (uint256) {"
        },
        {
          "line": 80,
          "text": "        uint256 totalEthValue = getEthValue(totalSupply());"
        },
        {
          "line": 81,
          "text": "        if (totalEthValue == 0) { return calcBase; }"
        },
        {
          "line": 82,
          "text": "        return calcBase.mul(address(this).balance).div(totalEthValue);"
