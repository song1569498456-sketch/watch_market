          "text": "        uint256 ethBalance = getTotalCollateral();"
        },
        {
          "line": 114,
          "text": "        require(ethBalance >= ethAmount, \"Insufficient ETH balance for exchange\");"
        },
        {
          "line": 115,
          "text": "        // Update balance & supply"
        },
        {
          "line": 116,
          "text": "        _burn(msg.sender, _rethAmount);"
        },
        {
