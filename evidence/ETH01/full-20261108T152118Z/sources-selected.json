          "text": ""
        },
        {
          "line": 105,
          "text": "    // Burn rETH for ETH"
        },
        {
          "line": 106,
          "text": "    function burn(uint256 _rethAmount) override external {"
        },
        {
          "line": 107,
          "text": "        // Check rETH amount"
        },
        {
          "line": 108,
          "text": "        require(_rethAmount > 0, \"Invalid token burn amount\");"
        },
        {
          "line": 109,
          "text": "        require(balanceOf(msg.sender) >= _rethAmount, \"Insufficient rETH balance\");"
        },
        {
          "line": 110,
          "text": "        // Get ETH amount"
        },
        {
          "line": 111,
          "text": "        uint256 ethAmount = getEthValue(_rethAmount);"
