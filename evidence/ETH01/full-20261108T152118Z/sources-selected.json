        {
          "line": 271,
          "text": "        for (uint256 i = 0; i < _requestIds.length; ++i) {"
        },
        {
          "line": 272,
          "text": "            _claim(_requestIds[i], _hints[i], msg.sender);"
        },
        {
          "line": 273,
          "text": "            _emitTransfer(msg.sender, address(0), _requestIds[i]);"
        },
        {
          "line": 274,
          "text": "        }"
        },
        {
          "line": 275,
          "text": "    }"
        },
        {
          "line": 276,
          "text": ""
        },
        {
          "line": 277,
          "text": "    /// @notice Claim one`_requestId` request once finalized sending locked ether to the owner"
        },
        {
          "line": 278,
          "text": "    /// @param _requestId request id to claim"
        },
        {
          "line": 394,
          "text": ""
        },
        {
          "line": 395,
          "text": "    function _checkWithdrawalRequestAmount(uint256 _amountOfStETH) internal pure {"
        },
        {
          "line": 396,
          "text": "        if (_amountOfStETH < MIN_STETH_WITHDRAWAL_AMOUNT) {"
        },
        {
          "line": 397,
          "text": "            revert RequestAmountTooSmall(_amountOfStETH);"
        },
        {
          "line": 398,
          "text": "        }"
        },
        {
          "line": 399,
          "text": "        if (_amountOfStETH > MAX_STETH_WITHDRAWAL_AMOUNT) {"
        },
        {
          "line": 400,
          "text": "            revert RequestAmountTooLarge(_amountOfStETH);"
        },
        {
          "line": 401,
          "text": "        }"
        },
        {
          "line": 402,
          "text": "    }"
        },
        {
          "line": 403,
          "text": ""
        },
        {
          "line": 404,
          "text": "    /// @notice returns claimable ether under the request. Returns 0 if request is not finalized or claimed"
        },
        {
          "line": 405,
          "text": "    function _getClaimableEther(uint256 _requestId, uint256 _hint) internal view returns (uint256) {"
        },
        {
          "line": 406,
          "text": "        if (_requestId == 0 || _requestId > getLastRequestId()) revert InvalidRequestId(_requestId);"
        },
        {
          "line": 407,
          "text": ""
        },
        {
          "line": 408,
          "text": "        if (_requestId > getLastFinalizedRequestId()) return 0;"
        },
        {
          "line": 409,
          "text": ""
        },
        {
          "line": 410,
          "text": "        WithdrawalRequest storage request = _getQueue()[_requestId];"
        },
        {
          "line": 411,
          "text": "        if (request.claimed) return 0;"
        }
      ]
