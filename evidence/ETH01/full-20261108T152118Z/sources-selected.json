        },
        {
          "line": 179,
          "text": "    /// @notice Request the batch of wstETH for withdrawal using EIP-2612 Permit"
        },
        {
          "line": 180,
          "text": "    /// @param _amounts an array of wstETH amount values"
        },
        {
