        {
          "line": 419,
          "text": "def get_dy(i: int128, j: int128, dx: uint256) -> uint256:"
        },
        {
          "line": 420,
          "text": "    xp: uint256[N_COINS] = self._balances()"
        },
        {
          "line": 421,
          "text": "    x: uint256 = xp[i] + dx"
        },
        {
          "line": 422,
          "text": "    y: uint256 = self.get_y(i, j, x, xp)"
        },
        {
          "line": 423,
          "text": "    dy: uint256 = xp[j] - y - 1"
        },
        {
          "line": 424,
          "text": "    fee: uint256 = self.fee * dy / FEE_DENOMINATOR"
        },
        {
          "line": 425,
          "text": "    return dy - fee"
        },
        {
          "line": 426,
          "text": ""
        },
        {
          "line": 427,
          "text": ""
        },
        {
          "line": 428,
          "text": "@payable"
