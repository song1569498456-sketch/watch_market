        {
          "line": 430,
          "text": "@nonreentrant('lock')"
        },
        {
          "line": 431,
          "text": "def exchange(i: int128, j: int128, dx: uint256, min_dy: uint256) -> uint256:"
        },
        {
          "line": 432,
          "text": "    \"\"\""
        },
        {
          "line": 433,
          "text": "    @notice Perform an exchange between two coins"
        },
        {
          "line": 434,
          "text": "    @dev Index values can be found via the `coins` public getter method"
        },
        {
          "line": 435,
          "text": "    @param i Index value for the coin to send"
        },
        {
          "line": 436,
          "text": "    @param j Index valie of the coin to recieve"
        },
        {
          "line": 437,
          "text": "    @param dx Amount of `i` being exchanged"
        },
        {
          "line": 438,
          "text": "    @param min_dy Minimum amount of `j` to receive"
        },
        {
          "line": 439,
          "text": "    @return Actual amount of `j` received"
        },
        {
          "line": 440,
          "text": "    \"\"\""
        },
        {
          "line": 441,
          "text": "    assert not self.is_killed  # dev: is killed"
        },
        {
          "line": 442,
          "text": "    # dx and dy are in aTokens"
        },
        {
          "line": 443,
          "text": ""
        },
        {
          "line": 444,
          "text": "    xp: uint256[N_COINS] = self._balances(msg.value)"
        },
        {
          "line": 445,
          "text": ""
        },
        {
          "line": 446,
          "text": "    x: uint256 = xp[i] + dx"
        },
        {
          "line": 447,
          "text": "    y: uint256 = self.get_y(i, j, x, xp)"
        },
        {
          "line": 448,
          "text": "    dy: uint256 = xp[j] - y - 1"
        },
        {
          "line": 449,
          "text": "    dy_fee: uint256 = dy * self.fee / FEE_DENOMINATOR"
        },
        {
          "line": 450,
          "text": ""
        },
        {
          "line": 451,
          "text": "    # Convert all to real units"
        },
        {
          "line": 452,
          "text": "    dy = dy - dy_fee"
        },
        {
          "line": 453,
          "text": "    assert dy >= min_dy, \"Exchange resulted in fewer coins than expected\""
        },
        {
          "line": 454,
          "text": ""
        },
        {
          "line": 455,
          "text": "    admin_fee: uint256 = self.admin_fee"
        },
        {
          "line": 456,
          "text": "    if admin_fee != 0:"
        },
        {
          "line": 457,
          "text": "        dy_admin_fee: uint256 = dy_fee * admin_fee / FEE_DENOMINATOR"
        },
        {
          "line": 458,
          "text": "        if dy_admin_fee != 0:"
        },
        {
          "line": 459,
          "text": "            self.admin_balances[j] += dy_admin_fee"
        },
        {
          "line": 460,
          "text": ""
        },
        {
          "line": 461,
          "text": "    coin: address = self.coins[1]"
        },
        {
          "line": 462,
          "text": "    if i == 0:"
        },
        {
          "line": 463,
          "text": "        assert msg.value == dx"
        },
        {
          "line": 464,
          "text": "        assert ERC20(coin).transfer(msg.sender, dy)"
        },
        {
          "line": 465,
          "text": "    else:"
        },
        {
          "line": 466,
          "text": "        assert msg.value == 0"
        },
        {
          "line": 467,
          "text": "        assert ERC20(coin).transferFrom(msg.sender, self, dx)"
        },
        {
          "line": 468,
          "text": "        raw_call(msg.sender, b\"\", value=dy)"
        },
        {
          "line": 469,
          "text": ""
        },
        {
          "line": 470,
          "text": "    log TokenExchange(msg.sender, i, dx, j, dy)"
        },
        {
          "line": 471,
          "text": ""
        },
        {
          "line": 472,
          "text": "    return dy"
        }
