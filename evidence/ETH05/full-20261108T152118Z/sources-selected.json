        {
          "line": 29,
          "text": "/// @title NFT implementation on top of {WithdrawalQueue}"
        },
        {
          "line": 30,
          "text": "/// NFT is minted on every request and burned on claim"
        },
        {
          "line": 31,
          "text": "///"
        },
        {
          "line": 32,
          "text": "/// @author psirex, folkyatina"
        },
        {
          "line": 33,
          "text": "contract WithdrawalQueueERC721 is IERC721Metadata, IERC4906, WithdrawalQueue {"
        },
        {
          "line": 34,
          "text": "    using Address for address;"
        },
        {
          "line": 35,
          "text": "    using Strings for uint256;"
        },
        {
          "line": 36,
          "text": "    using EnumerableSet for EnumerableSet.UintSet;"
        },
        {
          "line": 37,
          "text": "    using UnstructuredRefStorage for bytes32;"
        },
        {
          "line": 38,
          "text": "    using UnstructuredStorage for bytes32;"
        },
        {
          "line": 39,
          "text": ""
        },
        {
          "line": 40,
          "text": "    bytes32 internal constant TOKEN_APPROVALS_POSITION = keccak256(\"lido.WithdrawalQueueERC721.tokenApprovals\");"
        },
        {
          "line": 41,
          "text": "    bytes32 internal constant OPERATOR_APPROVALS_POSITION = keccak256(\"lido.WithdrawalQueueERC721.operatorApprovals\");"
        },
        {
          "line": 42,
          "text": "    bytes32 internal constant BASE_URI_POSITION = keccak256(\"lido.WithdrawalQueueERC721.baseUri\");"
        },
        {
          "line": 43,
          "text": "    bytes32 internal constant NFT_DESCRIPTOR_ADDRESS_POSITION ="
        },
        {
          "line": 167,
          "text": ""
        },
        {
          "line": 168,
          "text": "    /// @dev See {IERC721-ownerOf}."
        },
        {
          "line": 169,
          "text": "    function ownerOf(uint256 _requestId) public view override returns (address) {"
        },
        {
          "line": 170,
          "text": "        if (_requestId == 0 || _requestId > getLastRequestId()) revert InvalidRequestId(_requestId);"
        },
        {
          "line": 171,
          "text": ""
        },
        {
          "line": 172,
          "text": "        WithdrawalRequest storage request = _getQueue()[_requestId];"
        },
        {
          "line": 173,
          "text": "        if (request.claimed) revert RequestAlreadyClaimed(_requestId);"
        },
        {
          "line": 174,
          "text": ""
        },
        {
          "line": 175,
          "text": "        return request.owner;"
        },
        {
          "line": 176,
          "text": "    }"
        },
        {
          "line": 177,
          "text": ""
        },
        {
          "line": 178,
          "text": "    /// @dev See {IERC721-approve}."
        },
        {
          "line": 179,
          "text": "    function approve(address _to, uint256 _requestId) external override {"
        },
        {
          "line": 180,
          "text": "        address owner = ownerOf(_requestId);"
        },
        {
          "line": 181,
          "text": "        if (_to == owner) revert ApprovalToOwner();"
        },
        {
          "line": 182,
          "text": "        if (msg.sender != owner && !isApprovedForAll(owner, msg.sender)) revert NotOwnerOrApprovedForAll(msg.sender);"
        },
        {
          "line": 183,
          "text": ""
        },
        {
          "line": 184,
          "text": "        _approve(_to, _requestId);"
        },
        {
          "line": 185,
          "text": "    }"
        },
        {
          "line": 186,
          "text": ""
        },
        {
          "line": 228,
          "text": "    /// - `_requestId` request must not be claimed and be owned by `_from`."
        },
        {
          "line": 229,
          "text": "    /// - `msg.sender` should be approved, or approved for all, or owner"
        },
        {
          "line": 230,
          "text": "    function _transfer(address _from, address _to, uint256 _requestId) internal {"
        },
        {
          "line": 231,
          "text": "        if (_to == address(0)) revert TransferToZeroAddress();"
        },
        {
          "line": 232,
          "text": "        if (_to == _from) revert TransferToThemselves();"
        },
        {
          "line": 233,
          "text": "        if (_requestId == 0 || _requestId > getLastRequestId()) revert InvalidRequestId(_requestId);"
        },
        {
          "line": 234,
          "text": ""
        },
        {
          "line": 235,
          "text": "        WithdrawalRequest storage request = _getQueue()[_requestId];"
        },
        {
          "line": 236,
          "text": "        if (request.claimed) revert RequestAlreadyClaimed(_requestId);"
        },
        {
          "line": 237,
          "text": ""
        },
        {
          "line": 238,
          "text": "        if (_from != request.owner) revert TransferFromIncorrectOwner(_from, request.owner);"
        },
        {
          "line": 239,
          "text": "        // here and below we are sure that `_from` is the owner of the request"
        },
        {
          "line": 240,
          "text": "        address msgSender = msg.sender;"
        },
        {
          "line": 241,
          "text": "        if ("
        },
        {
          "line": 242,
          "text": "            !(_from == msgSender || isApprovedForAll(_from, msgSender) || _getTokenApprovals()[_requestId] == msgSender)"
        },
        {
          "line": 243,
          "text": "        ) {"
        },
        {
          "line": 244,
          "text": "            revert NotOwnerOrApproved(msgSender);"
        },
        {
          "line": 245,
          "text": "        }"
        },
        {
          "line": 246,
          "text": ""
        },
        {
          "line": 247,
          "text": "        delete _getTokenApprovals()[_requestId];"
        },
        {
          "line": 248,
          "text": "        request.owner = _to;"
        },
        {
          "line": 249,
          "text": ""
        }
