        {
          "line": 205,
          "text": "    /// @notice Returns status for requests with provided ids"
        },
        {
          "line": 206,
          "text": "    /// @param _requestIds array of withdrawal request ids"
        },
        {
          "line": 207,
          "text": "    function getWithdrawalStatus(uint256[] calldata _requestIds)"
        },
        {
          "line": 208,
          "text": "        external"
        },
        {
          "line": 209,
          "text": "        view"
        },
        {
          "line": 210,
          "text": "        returns (WithdrawalRequestStatus[] memory statuses)"
        },
        {
          "line": 211,
          "text": "    {"
        },
        {
          "line": 212,
          "text": "        statuses = new WithdrawalRequestStatus[](_requestIds.length);"
        },
        {
          "line": 213,
          "text": "        for (uint256 i = 0; i < _requestIds.length; ++i) {"
        },
        {
          "line": 214,
          "text": "            statuses[i] = _getStatus(_requestIds[i]);"
        },
        {
          "line": 215,
          "text": "        }"
        },
        {
          "line": 216,
          "text": "    }"
        },
        {
          "line": 217,
          "text": ""
        },
        {
          "line": 218,
          "text": "    /// @notice Returns amount of ether available for claim for each provided request id"
        },
        {
          "line": 219,
          "text": "    /// @param _requestIds array of request ids"
        },
        {
          "line": 220,
          "text": "    /// @param _hints checkpoint hints. can be found with `findCheckpointHints(_requestIds, 1, getLastCheckpointIndex())`"
        },
        {
          "line": 221,
          "text": "    /// @return claimableEthValues amount of claimable ether for each request, amount is equal to 0 if request"
        },
        {
          "line": 222,
          "text": "    ///  is not finalized or already claimed"
        },
        {
          "line": 223,
          "text": "    function getClaimableEther(uint256[] calldata _requestIds, uint256[] calldata _hints)"
        },
        {
          "line": 224,
          "text": "        external"
        },
        {
          "line": 225,
          "text": "        view"
        },
        {
          "line": 226,
          "text": "        returns (uint256[] memory claimableEthValues)"
        },
        {
          "line": 227,
          "text": "    {"
        },
        {
          "line": 228,
          "text": "        claimableEthValues = new uint256[](_requestIds.length);"
        },
        {
          "line": 229,
          "text": "        for (uint256 i = 0; i < _requestIds.length; ++i) {"
        },
        {
          "line": 230,
          "text": "            claimableEthValues[i] = _getClaimableEther(_requestIds[i], _hints[i]);"
        },
        {
          "line": 231,
          "text": "        }"
        },
        {
          "line": 232,
          "text": "    }"
        },
        {
          "line": 233,
          "text": ""
        },
        {
          "line": 234,
          "text": "    /// @notice Claim a batch of withdrawal requests if they are finalized sending ether to `_recipient`"
        },
        {
          "line": 235,
          "text": "    /// @param _requestIds array of request ids to claim"
        },
        {
          "line": 236,
          "text": "    /// @param _hints checkpoint hint for each id. Can be obtained with `findCheckpointHints()`"
        },
        {
          "line": 264,
          "text": "    ///  Reverts if any request is not finalized or already claimed"
        },
        {
          "line": 265,
          "text": "    ///  Reverts if msg sender is not an owner of the requests"
        },
        {
          "line": 266,
          "text": "    function claimWithdrawals(uint256[] calldata _requestIds, uint256[] calldata _hints) external {"
        },
        {
          "line": 267,
          "text": "        if (_requestIds.length != _hints.length) {"
        },
        {
          "line": 268,
          "text": "            revert ArraysLengthMismatch(_requestIds.length, _hints.length);"
        },
        {
          "line": 269,
          "text": "        }"
        },
        {
          "line": 270,
          "text": ""
        },
        {
          "line": 271,
          "text": "        for (uint256 i = 0; i < _requestIds.length; ++i) {"
        },
        {
          "line": 272,
          "text": "            _claim(_requestIds[i], _hints[i], msg.sender);"
        },
        {
          "line": 273,
          "text": "            _emitTransfer(msg.sender, address(0), _requestIds[i]);"
        },
        {
          "line": 274,
          "text": "        }"
        },
        {
          "line": 275,
          "text": "    }"
