    {
      "source": "metamorpho-deployments-readme",
      "url": "https://raw.githubusercontent.com/morpho-org/metamorpho/main/README.md",
      "retrieved_at_utc": "2026-11-08T15:52:55.169920+00:00",
      "request": null,
      "http_status": 200,
      "sha256": "719f7a99a3e64ea62ae385a535f0197eeef671dd5168b3a67b9592eb99e0bc86",
      "bytes_read": 11342,
      "excerpts": [
        {
          "line": 16,
          "text": "[`MetaMorpho`](./src/MetaMorpho.sol) vaults are [ERC-4626](https://eips.ethereum.org/EIPS/eip-4626) vaults, with ([ERC-2612](https://eips.ethereum.org/EIPS/eip-2612)) permit."
        },
        {
          "line": 17,
          "text": "One MetaMorpho vault is related to one loan asset on Morpho Blue."
        },
        {
          "line": 18,
          "text": "The [`MetaMorphoFactory`](./src/MetaMorphoFactory.sol) is deploying immutable onchain instances of MetaMorpho vaults."
        },
        {
          "line": 19,
          "text": ""
        },
        {
          "line": 20,
          "text": "Users can supply or withdraw assets at any time, depending on the available liquidity on Morpho Blue."
        },
        {
          "line": 21,
          "text": "A maximum of 30 markets can be enabled on a given MetaMorpho vault."
        },
        {
          "line": 22,
          "text": "Each market has a supply cap that guarantees that allocators cannot reallocate more than that limit to that market."
        },
        {
          "line": 23,
          "text": "The vault can have more exposure to a given market than its supply cap because of donations or because of interests."
        },
        {
          "line": 24,
          "text": "By default, the supply cap of a market is set to 0."
        },
        {
          "line": 25,
          "text": ""
        },
        {
          "line": 26,
          "text": "There are 4 different roles for a MetaMorpho vault: owner, curator, guardian & allocator."
        },
        {
          "line": 27,
          "text": ""
        },
        {
          "line": 28,
          "text": "The vault owner can set a performance fee, cutting up to 50% of the generated interest."
        },
        {
          "line": 83,
          "text": "- Set the `supplyQueue` and `withdrawQueue`, i.e. decide on the order of the markets to supply/withdraw from."
        },
        {
          "line": 84,
          "text": "  - Upon a deposit, the vault will supply up to the cap of each Morpho Blue market in the `supplyQueue` in the order set."
        },
        {
          "line": 85,
          "text": "  - Upon a withdrawal, the vault will withdraw up to the liquidity of each Morpho Blue market in the `withdrawQueue` in the order set."
        },
        {
          "line": 86,
          "text": "  - The `supplyQueue` only contains markets which cap has previously been non-zero."
        },
        {
          "line": 87,
          "text": "  - The `withdrawQueue` contains all markets that have a non-zero cap or a non-zero vault allocation."
        },
        {
          "line": 88,
          "text": "- Instantaneously reallocate funds by supplying on markets of the `withdrawQueue` and withdrawing from markets that have the same loan asset as the vault's asset."
        }
      ]
    },
    {
      "source": "metamorpho-nav-source",
      "url": "https://raw.githubusercontent.com/morpho-org/metamorpho/main/src/MetaMorpho.sol",
      "retrieved_at_utc": "2026-11-08T15:52:56.518146+00:00",
      "request": null,
      "http_status": 200,
      "sha256": "c218f3f26e8186399327b793c2f96312c7a2e118467a54dc99e5a16b079979f7",
      "bytes_read": 35967,
      "excerpts": [
        {
          "line": 589,
          "text": "    function totalAssets() public view override returns (uint256 assets) {"
        },
        {
          "line": 590,
          "text": "        for (uint256 i; i < withdrawQueue.length; ++i) {"
        },
        {
          "line": 591,
          "text": "            assets += MORPHO.expectedSupplyAssets(_marketParams(withdrawQueue[i]), address(this));"
        },
        {
          "line": 592,
          "text": "        }"
        },
        {
          "line": 593,
          "text": "    }"
        },
        {
          "line": 594,
          "text": ""
        },
        {
          "line": 595,
          "text": "    /* ERC4626 (INTERNAL) */"
        },
        {
          "line": 596,
          "text": ""
        },
        {
          "line": 597,
          "text": "    /// @inheritdoc ERC4626"
        },
        {
          "line": 598,
          "text": "    function _decimalsOffset() internal view override returns (uint8) {"
        },
        {
          "line": 599,
          "text": "        return DECIMALS_OFFSET;"
        },
        {
          "line": 600,
          "text": "    }"
        },
        {
          "line": 601,
          "text": ""
        },
        {
          "line": 602,
          "text": "    /// @dev Returns the maximum amount of asset (`assets`) that the `owner` can withdraw from the vault, as well as the"
        },
        {
          "line": 603,
          "text": "    /// new vault's total supply (`newTotalSupply`) and total assets (`newTotalAssets`)."
        },
        {
          "line": 604,
          "text": "    function _maxWithdraw(address owner)"
        },
        {
          "line": 605,
          "text": "        internal"
        },
        {
          "line": 606,
          "text": "        view"
        },
        {
          "line": 607,
          "text": "        returns (uint256 assets, uint256 newTotalSupply, uint256 newTotalAssets)"
        },
        {
          "line": 608,
          "text": "    {"
        },
        {
          "line": 609,
          "text": "        uint256 feeShares;"
        },
        {
          "line": 610,
          "text": "        (feeShares, newTotalAssets) = _accruedFeeShares();"
        },
        {
          "line": 611,
          "text": "        newTotalSupply = totalSupply() + feeShares;"
        },
        {
          "line": 612,
          "text": ""
        },
        {
          "line": 613,
          "text": "        assets = _convertToAssetsWithTotals(balanceOf(owner), newTotalSupply, newTotalAssets, Math.Rounding.Floor);"
        },
        {
          "line": 614,
          "text": "        assets -= _simulateWithdrawMorpho(assets);"
        },
        {
          "line": 807,
          "text": "    function _withdrawMorpho(uint256 assets) internal {"
        },
        {
          "line": 808,
          "text": "        for (uint256 i; i < withdrawQueue.length; ++i) {"
        },
        {
          "line": 809,
          "text": "            Id id = withdrawQueue[i];"
        },
        {
          "line": 810,
          "text": "            MarketParams memory marketParams = _marketParams(id);"
        },
        {
          "line": 811,
          "text": "            (uint256 supplyAssets,, Market memory market) = _accruedSupplyBalance(marketParams, id);"
        },
        {
          "line": 812,
          "text": ""
        },
        {
          "line": 813,
          "text": "            uint256 toWithdraw = UtilsLib.min("
        },
        {
          "line": 814,
          "text": "                _withdrawable(marketParams, market.totalSupplyAssets, market.totalBorrowAssets, supplyAssets), assets"
        },
        {
          "line": 815,
          "text": "            );"
        },
        {
          "line": 816,
          "text": ""
        },
        {
          "line": 817,
          "text": "            if (toWithdraw > 0) {"
        },
        {
          "line": 818,
          "text": "                // Using try/catch to skip markets that revert."
        },
        {
          "line": 819,
          "text": "                try MORPHO.withdraw(marketParams, toWithdraw, 0, address(this), address(this)) {"
        },
        {
          "line": 862,
          "text": "    function _withdrawable("
        },
        {
          "line": 863,
          "text": "        MarketParams memory marketParams,"
        },
        {
          "line": 864,
          "text": "        uint256 totalSupplyAssets,"
        },
        {
          "line": 865,
          "text": "        uint256 totalBorrowAssets,"
        },
        {
          "line": 866,
          "text": "        uint256 supplyAssets"
        },
        {
          "line": 867,
          "text": "    ) internal view returns (uint256) {"
        },
        {
          "line": 868,
          "text": "        // Inside a flashloan callback, liquidity on Morpho Blue may be limited to the singleton's balance."
        },
        {
          "line": 869,
          "text": "        uint256 availableLiquidity = UtilsLib.min("
        },
        {
          "line": 870,
          "text": "            totalSupplyAssets - totalBorrowAssets, ERC20(marketParams.loanToken).balanceOf(address(MORPHO))"
        },
        {
          "line": 871,
          "text": "        );"
        },
        {
          "line": 872,
          "text": ""
        },
        {
          "line": 873,
          "text": "        return UtilsLib.min(supplyAssets, availableLiquidity);"
        },
        {
          "line": 874,
          "text": "    }"
        }
      ]
    },
