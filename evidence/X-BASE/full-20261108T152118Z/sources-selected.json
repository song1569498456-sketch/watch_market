      "excerpts": [
        {
          "line": 110,
          "text": "    /// @notice Ensures that the caller is a cross-chain message from the other bridge."
        },
        {
          "line": 111,
          "text": "    modifier onlyOtherBridge() {"
        },
        {
          "line": 112,
          "text": "        require("
        },
        {
          "line": 113,
          "text": "            msg.sender == address(messenger) && messenger.xDomainMessageSender() == address(otherBridge),"
        },
        {
          "line": 114,
          "text": "            \"StandardBridge: function can only be called from the other bridge\""
        },
        {
          "line": 115,
          "text": "        );"
        },
        {
          "line": 116,
          "text": "        _;"
        },
        {
          "line": 117,
          "text": "    }"
        },
        {
          "line": 161,
          "text": "    /// @notice Sends ETH to the sender's address on the other chain."
        },
        {
          "line": 162,
          "text": "    /// @param _minGasLimit Minimum amount of gas that the bridge can be relayed with."
        },
        {
          "line": 163,
          "text": "    /// @param _extraData   Extra data to be sent with the transaction. Note that the recipient will"
        },
        {
          "line": 164,
          "text": "    ///                     not be triggered with this data, but it will be emitted and can be used"
        },
        {
          "line": 165,
          "text": "    ///                     to identify the transaction."
        },
        {
          "line": 166,
          "text": "    function bridgeETH(uint32 _minGasLimit, bytes calldata _extraData) public payable onlyEOA {"
        },
        {
          "line": 167,
          "text": "        _initiateBridgeETH(msg.sender, msg.sender, msg.value, _minGasLimit, _extraData);"
        },
        {
          "line": 168,
          "text": "    }"
        },
        {
          "line": 169,
          "text": ""
        },
        {
          "line": 170,
          "text": "    /// @notice Sends ETH to a receiver's address on the other chain. Note that if ETH is sent to a"
        },
        {
          "line": 171,
          "text": "    ///         smart contract and the call fails, the ETH will be temporarily locked in the"
        },
        {
          "line": 172,
          "text": "    ///         StandardBridge on the other chain until the call is replayed. If the call cannot be"
        },
        {
          "line": 173,
          "text": "    ///         replayed with any amount of gas (call always reverts), then the ETH will be"
        },
        {
          "line": 174,
          "text": "    ///         permanently locked in the StandardBridge on the other chain. ETH will also"
        },
        {
          "line": 175,
          "text": "    ///         be locked if the receiver is the other bridge, because finalizeBridgeETH will revert"
        },
        {
          "line": 239,
          "text": "    function finalizeBridgeETH("
        },
        {
          "line": 240,
          "text": "        address _from,"
        },
        {
          "line": 241,
          "text": "        address _to,"
        },
        {
          "line": 242,
          "text": "        uint256 _amount,"
        },
        {
          "line": 243,
          "text": "        bytes calldata _extraData"
        },
        {
          "line": 244,
          "text": "    )"
        },
        {
          "line": 245,
          "text": "        public"
        },
        {
          "line": 246,
          "text": "        payable"
        },
        {
          "line": 247,
          "text": "        onlyOtherBridge"
        },
        {
          "line": 248,
          "text": "    {"
        },
        {
          "line": 249,
          "text": "        require(paused() == false, \"StandardBridge: paused\");"
        },
        {
          "line": 250,
          "text": "        require(msg.value == _amount, \"StandardBridge: amount sent does not match amount required\");"
        },
        {
          "line": 251,
          "text": "        require(_to != address(this), \"StandardBridge: cannot send to self\");"
        },
        {
          "line": 252,
          "text": "        require(_to != address(messenger), \"StandardBridge: cannot send to messenger\");"
        },
        {
          "line": 253,
          "text": ""
        },
        {
          "line": 254,
          "text": "        // Emit the correct events. By default this will be _amount, but child"
        },
        {
          "line": 255,
          "text": "        // contracts may override this function in order to emit legacy events as well."
        },
        {
          "line": 256,
          "text": "        _emitETHBridgeFinalized(_from, _to, _amount, _extraData);"
        },
        {
          "line": 257,
          "text": ""
        },
        {
          "line": 258,
          "text": "        bool success = SafeCall.call(_to, gasleft(), _amount, hex\"\");"
        },
        {
          "line": 309,
          "text": "    function _initiateBridgeETH("
        },
        {
          "line": 310,
          "text": "        address _from,"
        },
        {
          "line": 311,
          "text": "        address _to,"
        },
        {
          "line": 312,
          "text": "        uint256 _amount,"
        },
        {
          "line": 313,
          "text": "        uint32 _minGasLimit,"
        },
        {
          "line": 314,
          "text": "        bytes memory _extraData"
        },
        {
          "line": 315,
          "text": "    )"
        },
        {
          "line": 316,
          "text": "        internal"
        },
        {
          "line": 317,
          "text": "    {"
        },
        {
          "line": 318,
          "text": "        require(msg.value == _amount, \"StandardBridge: bridging ETH must include sufficient ETH value\");"
        },
        {
          "line": 323,
          "text": ""
        },
        {
          "line": 324,
          "text": "        messenger.sendMessage{ value: _amount }({"
        },
        {
          "line": 325,
          "text": "            _target: address(otherBridge),"
        },
        {
          "line": 326,
          "text": "            _message: abi.encodeWithSelector(this.finalizeBridgeETH.selector, _from, _to, _amount, _extraData),"
        },
        {
          "line": 327,
          "text": "            _minGasLimit: _minGasLimit"
        },
        {
          "line": 328,
          "text": "        });"
        }
      ]
