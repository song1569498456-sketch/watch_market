      "excerpts": [
        {
          "line": 39,
          "text": "   * @dev Default percentage of borrower's debt to be repaid in a liquidation."
        },
        {
          "line": 40,
          "text": "   * @dev Percentage applied when the users health factor is above `CLOSE_FACTOR_HF_THRESHOLD`"
        },
        {
          "line": 41,
          "text": "   * Expressed in bps, a value of 0.5e4 results in 50.00%"
        },
        {
          "line": 42,
          "text": "   */"
        },
        {
          "line": 43,
          "text": "  uint256 internal constant DEFAULT_LIQUIDATION_CLOSE_FACTOR = 0.5e4;"
        },
        {
          "line": 44,
          "text": ""
        },
        {
          "line": 45,
          "text": "  /**"
        },
        {
          "line": 46,
          "text": "   * @dev This constant represents the upper bound on the health factor, below(inclusive) which the full amount of debt becomes liquidatable."
        },
        {
          "line": 48,
          "text": "   */"
        },
        {
          "line": 49,
          "text": "  uint256 public constant CLOSE_FACTOR_HF_THRESHOLD = 0.95e18;"
        },
        {
          "line": 50,
          "text": ""
        },
        {
          "line": 51,
          "text": "  /**"
        },
        {
          "line": 52,
          "text": "   * @dev This constant represents a base value threshold."
        },
        {
          "line": 55,
          "text": "   */"
        },
        {
          "line": 56,
          "text": "  uint256 public constant MIN_BASE_MAX_CLOSE_FACTOR_THRESHOLD = 2000e8;"
        },
        {
          "line": 57,
          "text": ""
        },
        {
          "line": 58,
          "text": "  /**"
        },
        {
          "line": 59,
          "text": "   * @dev This constant represents the minimum amount of assets in base currency that need to be leftover after a liquidation, if not clearing a position completely."
        },
        {
          "line": 60,
          "text": "   * This parameter is inferred from MIN_BASE_MAX_CLOSE_FACTOR_THRESHOLD as the logic is dependent."
        },
        {
          "line": 61,
          "text": "   * Assuming a MIN_BASE_MAX_CLOSE_FACTOR_THRESHOLD of `n` a liquidation of `n+1` might result in `n/2` leftover which is assumed to be still economically liquidatable."
        },
        {
          "line": 62,
          "text": "   * This mechanic was introduced to ensure liquidators don't optimize gas by leaving some wei on the liquidation."
        },
        {
          "line": 63,
          "text": "   */"
        },
        {
          "line": 64,
          "text": "  uint256 public constant MIN_LEFTOVER_BASE = MIN_BASE_MAX_CLOSE_FACTOR_THRESHOLD / 2;"
        },
        {
          "line": 213,
          "text": "    ValidationLogic.validateLiquidationCall("
        },
        {
          "line": 214,
          "text": "      borrowerConfig,"
        },
        {
          "line": 215,
          "text": "      collateralReserve,"
        },
        {
          "line": 216,
          "text": "      debtReserve,"
        },
        {
          "line": 219,
          "text": "        totalDebt: vars.borrowerReserveDebt,"
        },
        {
          "line": 220,
          "text": "        healthFactor: vars.healthFactor,"
        },
        {
          "line": 221,
          "text": "        borrower: params.borrower,"
        },
        {
          "line": 222,
          "text": "        liquidator: params.liquidator"
        },
        {
          "line": 223,
          "text": "      })"
        },
        {
          "line": 259,
          "text": "    uint256 maxLiquidatableDebt = vars.borrowerReserveDebt;"
        },
        {
          "line": 260,
          "text": "    // but if debt and collateral is above or equal MIN_BASE_MAX_CLOSE_FACTOR_THRESHOLD"
        },
        {
          "line": 261,
          "text": "    // and health factor is above CLOSE_FACTOR_HF_THRESHOLD this amount may be adjusted"
        },
        {
          "line": 262,
          "text": "    if ("
        },
        {
          "line": 263,
          "text": "      vars.borrowerReserveCollateralInBaseCurrency >= MIN_BASE_MAX_CLOSE_FACTOR_THRESHOLD &&"
        },
        {
          "line": 264,
          "text": "      vars.borrowerReserveDebtInBaseCurrency >= MIN_BASE_MAX_CLOSE_FACTOR_THRESHOLD &&"
        },
        {
          "line": 265,
          "text": "      vars.healthFactor > CLOSE_FACTOR_HF_THRESHOLD"
        },
        {
          "line": 266,
          "text": "    ) {"
        },
        {
          "line": 267,
          "text": "      uint256 totalDefaultLiquidatableDebtInBaseCurrency = vars.totalDebtInBaseCurrency.percentMul("
        },
        {
          "line": 268,
          "text": "        DEFAULT_LIQUIDATION_CLOSE_FACTOR"
        },
        {
          "line": 269,
          "text": "      );"
        },
        {
          "line": 270,
          "text": ""
        },
        {
          "line": 271,
          "text": "      // if the debt is more then DEFAULT_LIQUIDATION_CLOSE_FACTOR % of the whole,"
        },
        {
          "line": 272,
          "text": "      // then we CAN liquidate only up to DEFAULT_LIQUIDATION_CLOSE_FACTOR %"
        },
        {
          "line": 273,
          "text": "      if (vars.borrowerReserveDebtInBaseCurrency > totalDefaultLiquidatableDebtInBaseCurrency) {"
        },
        {
          "line": 274,
          "text": "        maxLiquidatableDebt ="
        },
        {
          "line": 275,
          "text": "          (totalDefaultLiquidatableDebtInBaseCurrency * vars.debtAssetUnit) /"
        },
        {
          "line": 279,
          "text": ""
        },
        {
          "line": 280,
          "text": "    vars.actualDebtToLiquidate = params.debtToCover > maxLiquidatableDebt"
        },
        {
          "line": 281,
          "text": "      ? maxLiquidatableDebt"
        },
        {
          "line": 282,
          "text": "      : params.debtToCover;"
        },
        {
          "line": 283,
          "text": ""
        },
        {
          "line": 285,
          "text": "      vars.actualCollateralToLiquidate,"
        },
        {
          "line": 286,
          "text": "      vars.actualDebtToLiquidate,"
        },
        {
          "line": 287,
          "text": "      vars.liquidationProtocolFeeAmount"
        },
        {
          "line": 288,
          "text": "    ) = _calculateAvailableCollateralToLiquidate("
        },
        {
          "line": 289,
          "text": "      vars.collateralReserveCache.reserveConfiguration,"
        },
        {
          "line": 290,
          "text": "      vars.collateralAssetPrice,"
        },
        {
          "line": 293,
          "text": "      vars.debtAssetUnit,"
        },
        {
          "line": 294,
          "text": "      vars.actualDebtToLiquidate,"
        },
        {
          "line": 295,
          "text": "      vars.borrowerCollateralBalance,"
        },
        {
          "line": 296,
          "text": "      vars.liquidationBonus"
        },
        {
          "line": 297,
          "text": "    );"
        },
        {
          "line": 390,
          "text": "    if (params.receiveAToken) {"
        },
        {
          "line": 391,
          "text": "      IAToken(vars.collateralReserveCache.aTokenAddress).transferOnLiquidation("
        },
        {
          "line": 392,
          "text": "        params.borrower,"
        },
        {
          "line": 393,
          "text": "        params.liquidator,"
        },
        {
          "line": 595,
          "text": "    vars.liquidationProtocolFeePercentage = collateralReserveConfiguration"
        },
        {
          "line": 596,
          "text": "      .getLiquidationProtocolFee();"
        },
        {
          "line": 597,
          "text": ""
        },
        {
          "line": 598,
          "text": "    // This is the base collateral to liquidate based on the given debt to cover"
        },
        {
          "line": 613,
          "text": ""
        },
        {
          "line": 614,
          "text": "    if (vars.liquidationProtocolFeePercentage != 0) {"
        },
        {
          "line": 615,
          "text": "      vars.bonusCollateral ="
        },
        {
          "line": 616,
          "text": "        vars.collateralAmount -"
        },
        {
          "line": 617,
          "text": "        vars.collateralAmount.percentDivFloor(liquidationBonus);"
        },
        {
          "line": 618,
          "text": ""
        },
        {
          "line": 619,
          "text": "      vars.liquidationProtocolFee = vars.bonusCollateral.percentMulCeil("
        },
        {
          "line": 620,
          "text": "        vars.liquidationProtocolFeePercentage"
        },
        {
          "line": 621,
          "text": "      );"
        },
        {
          "line": 622,
          "text": "      vars.collateralAmount -= vars.liquidationProtocolFee;"
        },
        {
          "line": 623,
          "text": "    }"
        },
        {
          "line": 624,
          "text": "    return (vars.collateralAmount, vars.debtAmountNeeded, vars.liquidationProtocolFee);"
        },
        {
          "line": 625,
          "text": "  }"
        }
      ]
    }
