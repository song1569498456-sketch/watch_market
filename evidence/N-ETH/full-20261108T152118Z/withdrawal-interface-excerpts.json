    {
      "line": 147,
      "text": "    /// @notice Finalize requests from last finalized one up to `_lastRequestIdToBeFinalized`"
    },
    {
      "line": 148,
      "text": "    /// @dev ether to finalize all the requests should be calculated using `prefinalize()` and sent along"
    },
    {
      "line": 149,
      "text": "    function finalize(uint256 _lastRequestIdToBeFinalized, uint256 _maxShareRate) external payable {"
    },
    {
      "line": 150,
      "text": "        _checkResumed();"
    },
    {
      "line": 151,
      "text": "        _checkRole(FINALIZE_ROLE, msg.sender);"
    },
    {
      "line": 152,
      "text": ""
    },
    {
      "line": 153,
      "text": "        uint256 firstFinalizedRequestId = getLastFinalizedRequestId() + 1;"
    },
    {
      "line": 154,
      "text": ""
    },
    {
      "line": 155,
      "text": "        _finalize(_lastRequestIdToBeFinalized, msg.value, _maxShareRate);"
    },
    {
      "line": 156,
      "text": ""
    },
    {
      "line": 157,
      "text": "        // ERC4906 metadata update event"
    },
    {
      "line": 158,
      "text": "        // We are updating all unfinalized to make it look different as they move closer to finalization in the future"
    },
    {
      "line": 159,
      "text": "        emit BatchMetadataUpdate(firstFinalizedRequestId, getLastRequestId());"
    },
