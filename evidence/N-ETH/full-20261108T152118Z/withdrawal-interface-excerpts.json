    {
      "line": 357,
      "text": "    function _constructTokenUri(uint256 _requestId) internal view returns (string memory) {"
    },
    {
      "line": 358,
      "text": "        string memory baseURI = _getBaseURI().value;"
    },
    {
      "line": 359,
      "text": "        if (bytes(baseURI).length == 0) return \"\";"
    },
    {
      "line": 360,
      "text": ""
    },
    {
      "line": 361,
      "text": "        // ${baseUri}/${_requestId}?requested=${amount}&created_at=${timestamp}[&finalized=${claimableAmount}]"
    },
    {
      "line": 362,
      "text": "        string memory uri = string("
    },
    {
      "line": 363,
      "text": "            // we have no string.concat in 0.8.9 yet, so we have to do it with bytes.concat"
    },
    {
      "line": 364,
      "text": "            bytes.concat("
    },
    {
      "line": 365,
      "text": "                bytes(baseURI),"
    },
    {
      "line": 366,
      "text": "                bytes(\"/\"),"
    },
    {
      "line": 367,
      "text": "                bytes(_requestId.toString()),"
    },
    {
      "line": 368,
      "text": "                bytes(\"?requested=\"),"
    },
    {
      "line": 369,
      "text": "                bytes("
    },
    {
      "line": 370,
      "text": "                    uint256(_getQueue()[_requestId].cumulativeStETH - _getQueue()[_requestId - 1].cumulativeStETH)"
    },
    {
      "line": 371,
      "text": "                        .toString()"
    },
    {
      "line": 372,
      "text": "                ),"
    },
    {
      "line": 373,
      "text": "                bytes(\"&created_at=\"),"
    },
    {
      "line": 374,
      "text": "                bytes(uint256(_getQueue()[_requestId].timestamp).toString())"
    },
    {
      "line": 375,
      "text": "            )"
    },
    {
      "line": 376,
      "text": "        );"
    },
    {
      "line": 377,
      "text": "        bool finalized = _requestId <= getLastFinalizedRequestId();"
    },
    {
      "line": 378,
      "text": ""
    },
    {
      "line": 379,
      "text": "        if (finalized) {"
    },
    {
      "line": 380,
      "text": "            uri = string("
    },
    {
      "line": 381,
      "text": "                bytes.concat("
    },
    {
      "line": 382,
      "text": "                    bytes(uri),"
    },
    {
      "line": 383,
      "text": "                    bytes(\"&finalized=\"),"
    },
    {
      "line": 384,
      "text": "                    bytes("
    },
    {
      "line": 385,
      "text": "                        _getClaimableEther(_requestId, _findCheckpointHint(_requestId, 1, getLastCheckpointIndex()))"
    },
