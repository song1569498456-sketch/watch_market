        {
          "line": 107,
          "text": "     * @dev Throws if called by any account other than a minter."
        },
        {
          "line": 108,
          "text": "     */"
        },
        {
          "line": 109,
          "text": "    modifier onlyMinters() {"
        },
        {
          "line": 110,
          "text": "        require(minters[msg.sender], \"FiatToken: caller is not a minter\");"
        },
        {
          "line": 111,
          "text": "        _;"
        },
        {
          "line": 112,
          "text": "    }"
        },
        {
          "line": 357,
          "text": "    /**"
        },
        {
          "line": 358,
          "text": "     * @notice Allows a minter to burn some of its own tokens."
        },
        {
          "line": 359,
          "text": "     * @dev The caller must be a minter, must not be blacklisted, and the amount to burn"
        },
        {
          "line": 360,
          "text": "     * should be less than or equal to the account's balance."
        },
        {
          "line": 361,
          "text": "     * @param _amount the amount of tokens to be burned."
        },
        {
          "line": 362,
          "text": "     */"
        },
        {
          "line": 363,
          "text": "    function burn(uint256 _amount)"
        },
        {
          "line": 364,
          "text": "        external"
        },
        {
          "line": 365,
          "text": "        virtual"
        },
        {
          "line": 366,
          "text": "        whenNotPaused"
        },
        {
          "line": 367,
          "text": "        onlyMinters"
        },
        {
          "line": 368,
          "text": "        notBlacklisted(msg.sender)"
        },
        {
          "line": 369,
          "text": "    {"
        },
        {
          "line": 370,
          "text": "        uint256 balance = _balanceOf(msg.sender);"
        },
        {
          "line": 371,
          "text": "        require(_amount > 0, \"FiatToken: burn amount not greater than 0\");"
        },
        {
          "line": 372,
          "text": "        require(balance >= _amount, \"FiatToken: burn amount exceeds balance\");"
        },
        {
          "line": 373,
          "text": ""
        },
        {
          "line": 374,
          "text": "        totalSupply_ = totalSupply_.sub(_amount);"
        },
        {
          "line": 375,
          "text": "        _setBalance(msg.sender, balance.sub(_amount));"
        },
        {
          "line": 376,
          "text": "        emit Burn(msg.sender, _amount);"
        },
        {
          "line": 377,
          "text": "        emit Transfer(msg.sender, address(0), _amount);"
        }
      ]
