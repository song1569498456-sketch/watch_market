      "excerpts": [
        {
          "line": 15,
          "text": "    ContextMixin"
        },
        {
          "line": 16,
          "text": "{"
        },
        {
          "line": 17,
          "text": "    bytes32 public constant DEPOSITOR_ROLE = keccak256(\"DEPOSITOR_ROLE\");"
        },
        {
          "line": 18,
          "text": ""
        },
        {
          "line": 19,
          "text": "    constructor("
        },
        {
          "line": 20,
          "text": "        string memory name_,"
        },
        {
          "line": 21,
          "text": "        string memory symbol_,"
        },
        {
          "line": 22,
          "text": "        uint8 decimals_,"
        },
        {
          "line": 23,
          "text": "        address childChainManager"
        },
        {
          "line": 24,
          "text": "    ) public ERC20(name_, symbol_) {"
        },
        {
          "line": 25,
          "text": "        _setupContractId(\"ChildERC20\");"
        },
        {
          "line": 26,
          "text": "        _setupDecimals(decimals_);"
        },
        {
          "line": 27,
          "text": "        _setupRole(DEFAULT_ADMIN_ROLE, _msgSender());"
        },
        {
          "line": 28,
          "text": "        _setupRole(DEPOSITOR_ROLE, childChainManager);"
        },
        {
          "line": 29,
          "text": "        _initializeEIP712(name_);"
        },
        {
          "line": 30,
          "text": "    }"
        },
        {
          "line": 31,
          "text": ""
        },
        {
          "line": 32,
          "text": "    // This is to support Native meta transactions"
        },
        {
          "line": 33,
          "text": "    // never use msg.sender directly, use _msgSender() instead"
        },
        {
          "line": 34,
          "text": "    function _msgSender()"
        },
        {
          "line": 35,
          "text": "        internal"
        },
        {
          "line": 36,
          "text": "        override"
        },
        {
          "line": 37,
          "text": "        view"
        },
        {
          "line": 38,
          "text": "        returns (address payable sender)"
        },
        {
          "line": 39,
          "text": "    {"
        },
        {
          "line": 49,
          "text": "     * @param depositData abi encoded amount"
        },
        {
          "line": 50,
          "text": "     */"
        },
        {
          "line": 51,
          "text": "    function deposit(address user, bytes calldata depositData)"
        },
        {
          "line": 52,
          "text": "        external"
        },
        {
          "line": 53,
          "text": "        override"
        },
        {
          "line": 54,
          "text": "        only(DEPOSITOR_ROLE)"
        },
        {
          "line": 55,
          "text": "    {"
        },
        {
          "line": 56,
          "text": "        uint256 amount = abi.decode(depositData, (uint256));"
        },
        {
          "line": 57,
          "text": "        _mint(user, amount);"
        },
        {
          "line": 58,
          "text": "    }"
        },
        {
          "line": 59,
          "text": ""
        },
        {
          "line": 60,
          "text": "    /**"
        },
        {
          "line": 61,
          "text": "     * @notice called when user wants to withdraw tokens back to root chain"
        },
        {
          "line": 62,
          "text": "     * @dev Should burn user's tokens. This transaction will be verified when exiting on root chain"
        },
        {
          "line": 63,
          "text": "     * @param amount amount of tokens to withdraw"
        },
        {
          "line": 64,
          "text": "     */"
        },
        {
          "line": 65,
          "text": "    function withdraw(uint256 amount) external {"
        },
        {
          "line": 66,
          "text": "        _burn(_msgSender(), amount);"
        },
        {
          "line": 67,
          "text": "    }"
        },
        {
          "line": 68,
          "text": "}"
        }
      ]
    }
